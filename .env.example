# Copy to .env and fill in. .env is gitignored.

# otari.ai (US region). Use https://eu.api.otari.ai/api/v1 for an EU account,
# or http://127.0.0.1:8000/api/v1 for the local gateway in dev/.
OTARI_BASE_URL=https://otari.ai/api/v1
OTARI_API_KEY=

# Optional: a GitHub token with read-only access raises the API rate limit.
# Triagewell never writes to GitHub unless posting is switched on below.
GITHUB_TOKEN=

# Model roles. The defaults are the routing policy names from SETUP-OTARI.md;
# the fallbacks are used only if a policy does not exist on the workspace.
# TRIAGEWELL_SORTER_MODEL=triagewell-sorter
# TRIAGEWELL_SORTER_FALLBACK=nvidia/nemotron-3.5-lightning-30b-a3b
# TRIAGEWELL_INVESTIGATOR_MODEL=triagewell-investigator
# TRIAGEWELL_INVESTIGATOR_FALLBACK=openai/gpt-oss-120b
# TRIAGEWELL_SCREEN_MODEL=meta/llama-guard-4-12b
# Reasoning effort per role ("off" sends none). Reasoning tokens count against
# max_tokens, so the sorter answers without reasoning.
# TRIAGEWELL_SORTER_REASONING=none
# TRIAGEWELL_INVESTIGATOR_REASONING=low

# MCP: a workspace-stored server id, or the inline URL (DeepWiki by default).
# TRIAGEWELL_MCP_SERVER_ID=
# TRIAGEWELL_MCP_URL=https://mcp.deepwiki.com/mcp

# Pages linked from an issue that Otari fetches (each is billed like a sandbox run).
# TRIAGEWELL_MAX_FETCHES=1

# Local spending limits, on top of Otari's budgets.
# TRIAGEWELL_DAILY_LIMIT_USD=0.50
# TRIAGEWELL_ISSUE_LIMIT_USD=0.05

# Posting replies to GitHub. Off unless all of these are set AND --post is passed.
TRIAGEWELL_ALLOW_POST=0
# TRIAGEWELL_POST_REPOS=your-name/your-test-repo
